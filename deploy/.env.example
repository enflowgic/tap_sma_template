# TAP Template Agent - Environment Configuration
# Copy this file to .env and update values
#
# CONFIGURATION PRECEDENCE:
#   1. Environment variables (this file when sourced)
#   2. tap-agent.yaml manifest (default values)
#
# Environment variables OVERRIDE manifest values where applicable.

# =============================================================================
# Google Cloud Configuration (REQUIRED)
# =============================================================================

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# =============================================================================
# Agent Configuration (Optional - defaults from tap-agent.yaml)
# =============================================================================

# Model to use - OVERRIDES tap-agent.yaml deployment.model
# Current options: gemini-3-flash-preview, gemini-3-pro-preview
# Uncomment to override manifest:
# TAP_MODEL_NAME=gemini-3-flash-preview

# Log level - OVERRIDES tap-agent.yaml deployment.env
# Uncomment to override manifest:
# LOG_LEVEL=INFO

# =============================================================================
# Billing Configuration (REQUIRED for registration)
# =============================================================================
# All pricing values are in NANODOLLARS per token.
# Conversion: 1,000,000,000 nanodollars = $1.00
#
# Example pricing:
#   $0.00001 per token = 10,000 nanodollars
#   $0.000012 per token = 12,000 nanodollars
#   $0 per token = 0 nanodollars (free tier or pass-through)
#
# These are used by register_agent.py --input-cogs, --input-margin, etc.
# Set these to document your intended pricing, then use them in registration.
# =============================================================================

# Input token pricing (nanodollars per token)
TAP_INPUT_COGS_NANODOLLARS=0
TAP_INPUT_MARGIN_NANODOLLARS=10000

# Output token pricing (nanodollars per token)
TAP_OUTPUT_COGS_NANODOLLARS=0
TAP_OUTPUT_MARGIN_NANODOLLARS=12000

# =============================================================================
# Owner IDs (REQUIRED for registration)
# =============================================================================
# Get these from TAP admin or your organization settings.
# These identify who owns the agent for billing and audit purposes.

TAP_OWNER_ORG_ID=your-org-uuid
TAP_OWNER_USER_ID=your-user-uuid

# =============================================================================
# Input Validation (Optional)
# =============================================================================
# The TAP platform automatically wraps agents with input validation.
# These settings control that behavior.

# Model for input validation (defaults to same as main model)
# TAP_VALIDATION_MODEL=gemini-3-flash-preview

# Skip automatic input validation (default: false)
# Set to true if your agent handles all validation internally
# TAP_SKIP_VALIDATION=false

# =============================================================================
# Development Settings
# =============================================================================

# Enable mock transfer for local testing (true/false)
# When true, transfer_to_agent() returns mock responses without calling Gateway
TAP_USE_MOCK_TRANSFER=false

# =============================================================================
# Service URLs (Optional - for local development)
# =============================================================================
# These are typically set automatically in Cloud Run.
# Only set these for local development against specific environments.

# COGNEE_REGISTRY_URL=https://tap-cognee-registry-xxx.run.app
# TAP_BFF_URL=https://platform.tailoredagents.ai

# =============================================================================
# Registration Quick Reference
# =============================================================================
# After deploying to Cloud Run, register your agent:
#
#   python scripts/register_agent.py \
#     --cloud-run-url https://my-agent-xxx.run.app \
#     --owner-org-id $TAP_OWNER_ORG_ID \
#     --owner-user-id $TAP_OWNER_USER_ID \
#     --input-cogs $TAP_INPUT_COGS_NANODOLLARS \
#     --input-margin $TAP_INPUT_MARGIN_NANODOLLARS \
#     --output-cogs $TAP_OUTPUT_COGS_NANODOLLARS \
#     --output-margin $TAP_OUTPUT_MARGIN_NANODOLLARS \
#     --tier tertiary
#
# Or use --dry-run to preview without registering.
