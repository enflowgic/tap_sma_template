# TAP Template Agent - Environment Configuration
# Copy this file to .env and update values

# =============================================================================
# Google Cloud Configuration (Required)
# =============================================================================

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# =============================================================================
# Agent Configuration
# =============================================================================

# Model to use (gemini-3-flash-preview or gemini-3-pro-preview)
TAP_MODEL_NAME=gemini-3-flash-preview

# Agent name (must match tap-agent.yaml)
TAP_AGENT_NAME=my-agent

# =============================================================================
# Developer Information (for Agent Card)
# =============================================================================

TAP_DEVELOPER_ORG=My Company
TAP_DEVELOPER_EMAIL=developer@example.com
TAP_DEVELOPER_URL=https://example.com

# =============================================================================
# Pricing Configuration
# =============================================================================

TAP_PRICING_PER_1K=0.003
TAP_EST_TOKENS=2500

# =============================================================================
# Development Settings
# =============================================================================

# Enable mock transfer for local testing (true/false)
TAP_USE_MOCK_TRANSFER=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# Deployment Configuration
# =============================================================================

# Staging bucket for Vertex AI deployment
STAGING_BUCKET=gs://your-project-id-tap-staging
